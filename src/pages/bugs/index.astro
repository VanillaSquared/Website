---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchBar from "@/components/SearchBar";
import { getVisibleNewsArticles } from "@/news/server";

const latestNewsPath = getVisibleNewsArticles()[0]?.path ?? "/news";
---
<BaseLayout title="Bug Archive | Vanilla²" description="The archived Vanilla² issue tracker.">
  <section class="flex flex-1 justify-center bg-background px-6 py-12 sm:py-16">
    <div class="w-full max-w-3xl">
      <div class="rounded-xl border-2 border-divider bg-card p-6 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent">Read-only archive</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-heading sm:text-4xl">The bug tracker has been archived</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-muted">
          Bug reports are no longer fetched, searchable, or accepted. This page remains available so existing links clearly explain why the tracker is unavailable.
        </p>

        <div class="mt-7" aria-label="Archived bug tracker preview">
          <SearchBar
            locked
            showPreview={false}
            defaultValue="Bug tracker archived"
            label="Archived bug tracker"
            className="max-w-none"
            client:load
          />
        </div>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href={latestNewsPath} class="rounded-xl border-2 border-button-primary-outline bg-button-primary px-4 py-2 text-base font-semibold text-button-text transition-colors hover:border-button-primary-outline-hover hover:bg-button-primary-hover">Read the archive announcement</a>
          <a href="/docs" class="rounded-xl border-2 border-button-tertiary-outline bg-button-tertiary px-4 py-2 text-base font-semibold text-button-tertiary-text transition-colors hover:border-button-tertiary-outline-hover hover:bg-button-tertiary-hover">Browse documentation</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
