---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Checkmark from "@/components/Checkmark";
import { getBugStatusCheckmarkProps } from "@/bugs/checkmark";
import { BUG_PUBLIC_CACHE_CONTROL, getBugReportById, getBugReportComments } from "@/bugs/server";
import { renderMarkdownToHtml } from "@/markdown/render.jsx";
import { formatEuropeanDateTime } from "@/utils/dateTime";

const bug = await getBugReportById(decodeURIComponent(Astro.params.bug)).catch(() => null);
if (!bug) return Astro.redirect("/404", 404);

Astro.response.headers.set("Cache-Control", BUG_PUBLIC_CACHE_CONTROL);

const comments = await getBugReportComments(bug.id).catch(() => []);
const sourceHtml = await renderMarkdownToHtml(bug.source, `/bugs/${bug.id}`);
const renderedComments = await Promise.all(comments.map(async (comment) => ({
  ...comment,
  html: await renderMarkdownToHtml(comment.source, `/bugs/${bug.id}`),
})));
const categoryLabel = bug.category === "vanilla-squared" ? "Mod" : "Website";
const priorityLabel = bug.priority === "Code Red" ? "Urgent" : bug.priority === "Unset" ? "None" : bug.priority;
const priorityVariant = { Low: "low", Medium: "medium", High: "high", "Code Red": "codeRed", Unset: "subtle" }[bug.priority] ?? "subtle";
const statusColor = {
  Fixed: "var(--vsq-filter-status-fixed)",
  Unconfirmed: "var(--vsq-filter-status-unconfirmed)",
  Confirmed: "var(--vsq-filter-status-confirmed)",
  "Works as intended": "var(--vsq-filter-status-intended)",
  "Vanilla bug": "var(--vsq-filter-status-vanilla)",
}[bug.status];
const created = formatEuropeanDateTime(bug.createdAt, { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }, "Unknown").replace(/^(\d{1,2}) /, "$1. ");
const statusCheckmarkProps = getBugStatusCheckmarkProps(bug);
---
<BaseLayout title={`${bug.publicId.toUpperCase()} | Vanilla² Bugs`} description={bug.title}>
  <section class="flex flex-1 justify-center bg-background px-6 py-10">
    <div class="w-full max-w-6xl">
      <a href="/bugs" class="mb-4 inline-flex text-sm font-semibold text-accent transition-colors hover:text-heading">← All bugs</a>
      <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="min-w-0 space-y-4">
          <article class="min-w-0 overflow-hidden rounded-2xl border border-divider bg-card">
            <header class="border-b border-divider px-5 py-5 sm:px-7">
              <p class="mb-2 font-mono text-xs font-bold text-accent">{bug.publicId.toUpperCase()}</p>
              <h1 class="flex items-start gap-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">
                <Checkmark {...statusCheckmarkProps} className="mt-1.5 sm:mt-2" />
                <span>{bug.title}</span>
              </h1>
            </header>
            <div class="px-5 py-6 sm:px-7">
              <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center rounded-md bg-tag px-2.5 py-1 text-xs font-semibold text-muted">{categoryLabel}</span>
                <span class={`inline-flex items-center rounded-md px-2.5 py-1 text-xs font-semibold ${priorityVariant === "subtle" ? "bg-tag text-muted" : priorityVariant === "codeRed" ? "bg-[var(--vsq-tag-code-red-bg)] text-[var(--vsq-tag-code-red-text)]" : `bg-[var(--vsq-tag-${priorityVariant}-bg)] text-[var(--vsq-tag-${priorityVariant}-text)]`}`}>{priorityLabel}</span>
                <span class="inline-flex items-center rounded-md bg-accent/10 px-2.5 py-1 text-xs font-semibold" style={`color: ${statusColor ?? "var(--vsq-text-heading)"}`}>{bug.status}</span>
              </div>
              <div class="docs-content mt-5" set:html={sourceHtml}></div>
            </div>
          </article>

          <section class="space-y-3">
            {renderedComments.map((comment) => (
              <article class="flex items-start gap-3">
                {comment.avatarUrl ? <img src={comment.avatarUrl} alt={`${comment.author} avatar`} loading="lazy" decoding="async" class="mt-5 h-9 w-9 shrink-0 rounded-full object-cover" /> : <div class="mt-5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-control text-xs font-semibold text-muted" aria-hidden="true">{comment.author.slice(0, 1).toUpperCase()}</div>}
                <div class="min-w-0 flex-1">
                  <header class="mb-1 flex flex-wrap items-baseline gap-x-2 gap-y-1 px-1 text-xs text-muted">
                    {comment.authorUrl ? <a href={comment.authorUrl} class="font-semibold text-heading transition-colors hover:text-accent" target="_blank" rel="noreferrer">{comment.author}</a> : <span class="font-semibold text-heading">{comment.author}</span>}
                    <time datetime={comment.createdAt}>{formatEuropeanDateTime(comment.createdAt, { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit", timeZone: "UTC" }, "Unknown time")}</time>
                    {comment.updatedAt !== comment.createdAt ? <span class="text-subtle">edited</span> : null}
                  </header>
                  <div class="inline-block max-w-full rounded-2xl rounded-tl-md bg-control px-4 py-3 text-sm text-soft">
                    <div class="docs-content" set:html={comment.html}></div>
                  </div>
                </div>
              </article>
            ))}
          </section>
        </div>

        <aside class="lg:sticky lg:top-24">
          <div class="rounded-2xl border-2 border-divider bg-card p-5">
            <h2 class="text-base font-semibold text-heading">Details</h2>
            <dl class="mt-2 space-y-2">
              <div><dt class="text-xs font-semibold leading-4 text-subtle">Category</dt><dd class="mt-0.5 text-sm text-accent">{categoryLabel}</dd></div>
              <div><dt class="text-xs font-semibold leading-4 text-subtle">Priority</dt><dd class="mt-0.5 text-sm text-soft">{priorityLabel}</dd></div>
              <div><dt class="text-xs font-semibold leading-4 text-subtle">Status</dt><dd class="mt-0.5 text-sm" style={`color: ${statusColor ?? "var(--vsq-text-heading)"}`}>{bug.status}</dd></div>
              <div><dt class="text-xs font-semibold leading-4 text-subtle">Minecraft version</dt><dd class="mt-0.5 text-sm text-soft">{bug.minecraftVersion}</dd></div>
              <div><dt class="text-xs font-semibold leading-4 text-subtle">Mod version</dt><dd class="mt-0.5 text-sm text-soft">{bug.modVersion}</dd></div>
              <div><dt class="text-xs font-semibold leading-4 text-subtle">Operating system</dt><dd class="mt-0.5 text-sm text-soft">{bug.operatingSystem}</dd></div>
              <div><dt class="text-xs font-semibold leading-4 text-subtle">Created</dt><dd class="mt-0.5 text-sm text-muted">{created}</dd></div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
