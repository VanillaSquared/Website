---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import DocsPage from "@/components/DocsPage.astro";
import { getBreadcrumbs, getDocsData, getDocument } from "@/docs/server";
import { renderMarkdownToHtml } from "@/markdown/render.jsx";

const { navigation } = getDocsData();
const document = getDocument([]);
const breadcrumbs = getBreadcrumbs(document);
const html = await renderMarkdownToHtml(document.source, document.linkBase);
---
<BaseLayout
  title={`${document.title} | Vanilla² Docs`}
  description={document.description || `Vanilla² documentation: ${document.title}.`}
  showFooter={false}
  header={{ docsNavigation: { items: navigation, selectedId: document.path } }}
>
  <DocsPage document={document} navigation={navigation} breadcrumbs={breadcrumbs} html={html} />
</BaseLayout>
