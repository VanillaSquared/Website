---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import NotFoundPage from "@/components/NotFoundPage.astro";
import { getLicence } from "@/licences/server";
import { renderMarkdownToHtml } from "@/markdown/render.jsx";

export function getStaticPaths() {
  return ["mod", "website"].map((type) => ({ params: { type } }));
}

const type = Astro.params.type;
const licence = getLicence({ mod: "modlicence", website: "licence" }[type]);
const html = licence ? await renderMarkdownToHtml(licence.source, `/license/${type}`) : null;
---
{licence ? (
  <BaseLayout title={`${licence.title} | Vanilla²`} description={licence.description}>
    <article class="mx-auto w-full max-w-3xl flex-1 px-6 py-16 sm:py-20">
      <div class="docs-content" set:html={html}></div>
    </article>
  </BaseLayout>
) : <NotFoundPage />}
